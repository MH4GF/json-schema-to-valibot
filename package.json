{
  "name": "json-schema-to-valibot-monorepo",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test -w json-schema-to-valibot",
    "test:coverage": "npm run test:coverage -w json-schema-to-valibot",
    "fmt": "biome check --fix --unsafe",
    "lint": "npm run lint --workspaces && npm run lint:biome",
    "lint:biome": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.7.3"
  }
}
